{
  "name": "@stockroom/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "relay": "node --import tsx src/main.ts relay",
    "anchor": "node --import tsx src/main.ts anchor",
    "liquidate": "node --import tsx src/main.ts liquidate",
