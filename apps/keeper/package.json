    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stockroom/sdk": "workspace:*",
    "dotenv": "^17.2.3",
    "viem": "^2.39.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
